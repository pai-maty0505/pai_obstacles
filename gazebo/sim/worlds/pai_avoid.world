<?xml version="1.0" ?>
<!--
  回避デモ用ワールド（Phase 1）
  - ワールド名は default（scripts/run_mlp_gazebo_demo.py が /world/default/create を使うため）
  - 障害物はデモスクリプトが実行時に配置する
  - 太陽と地面をファイル内に定義し、Fuel からのダウンロードに依存しない
  - 物理ステップ 1 ms、実時間係数 1.0（等倍速で録画するため）
  - 物理エンジンは bullet-featherstone。既定の dartsim では、ロボットのメッシュの衝突形状が
    物理計算に入らず、アームが物体をすり抜けるため（docs/results/phase1/README.md）
-->
<sdf version="1.9">
  <world name="default">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine><filename>gz-physics-bullet-featherstone-plugin</filename></engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- 接触の記録に使う（Phase 2 以降、不許可接触の自動判定） -->
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.85 0.88 0.92 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.3 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
        <!-- 床に触れたものを記録する（ロボットが床に触れたら不合格。運搬物は、つかむ前に床に置かれている間だけ許可） -->
        <sensor name="contact" type="contact">
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <contact><collision>collision</collision><topic>/pai/ground_contacts</topic></contact>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
